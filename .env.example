# LexAI Environment Configuration
# Get your free Gemini API key at: https://aistudio.google.com/apikeys
GEMINI_API_KEY=your_api_key_here

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Database (use SQLite for free tier, or PostgreSQL on Render)
DATABASE_URL=sqlite:///legal_ai.db

# Secret Key (generate a secure key)
SECRET_KEY=your_secret_key_here
